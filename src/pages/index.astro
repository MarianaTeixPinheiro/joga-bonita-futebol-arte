---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import PriceTag from '../components/ui/PriceTag.astro';

import imgHero from '../assets/img/hero-colecao-futebol-arte.png';
import logoBranco from '../assets/img/joga-bonita-ver-branco.png';

// As 8 estampas da coleção (mesma ordem do brief).
import imgNoiteEstrelada from '../assets/img/estampa-noite-estrelada.png';
import imgAbaporu from '../assets/img/estampa-abaporu-boleira.png';
import imgGritoRainha from '../assets/img/estampa-o-grito-da-rainha.png';
import imgUltimaResenha from '../assets/img/estampa-ultima-resenha.png';
import imgGirassois from '../assets/img/estampa-girassois-van-gogh.png';
import imgFutebolMulherArte from '../assets/img/estampa-futebol-de-mulher-e-arte.png';
import imgMocaPerola from '../assets/img/estampa-moca-com-brinco-de-perola.png';
import imgPicasso from '../assets/img/estampa-futebol-arte-picasso.png';

import imgGabriela from '../assets/img/depoimento-gabriela.jpeg';
import imgFundadoras from '../assets/img/fundadoras.png';
import imgPromoModelos from '../assets/img/promo-modelos-futebol-arte.png';
import logoPreto from '../assets/img/joga-bonita-ver-preto.png';

// Galeria "o futebol delas não para por aqui" — outras estampas da loja.
import imgEstBrasil from '../assets/img/dobra5-estampa-brasil.webp';
import imgEstFutFem from '../assets/img/dobra5-estampa-futebol-feminino.webp';
import imgEstMulher from '../assets/img/dobra5-estampa-mulher-tambem-joga.webp';
import imgEstQueen from '../assets/img/dobra5-estampa-the-queen.webp';
import imgEstCaramelo from '../assets/img/dobra5-estampa-caramelo.webp';

/* ----------------------------------------------------------------------------
 * Landing — "coleção futebol arte"
 * COLLECTION_URL drives the brand CTAs (header / hero / promo / closing).
 * `estampas` drives the product grid — each is a real product from a coleção
 * "futebol-arte" na loja (mesmo preço e desconto pra todas: R$109,90, de R$139,90).
 * -------------------------------------------------------------------------- */
const COLLECTION_URL = 'https://www.jogabonita.com.br/jogabonita/collections/futebol-arte';
const PRODUCT_BASE = 'https://www.jogabonita.com.br/jogabonita/product/';

const estampas = [
  {
    id: 'noite-estrelada', nome: 'a noite perfeita', img: imgNoiteEstrelada,
    tagline: 'para quem quer jogar toda santa noite',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-noite-estrelada-joga-bonita`,
  },
  {
    id: 'abaporu', nome: 'abaporu boleira', img: imgAbaporu,
    tagline: 'para quem joga com identidade brasileira',
    url: `${PRODUCT_BASE}feminina-de-futebol-arte-estampa-abaporu-boleira-joga-bonita`,
  },
  {
    id: 'grito-rainha', nome: 'o grito da rainha', img: imgGritoRainha,
    tagline: 'para quem vive o futebol intensamente',
    url: `${PRODUCT_BASE}feminina-de-futebol-arte-estampa-o-grito-da-rainha-joga-bonita`,
  },
  {
    id: 'ultima-resenha', nome: 'a última resenha', img: imgUltimaResenha,
    tagline: 'para quem está sempre pronta',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-ultima-resenha-joga-bonita`,
  },
  {
    id: 'girassois', nome: 'girassóis de van gogh', img: imgGirassois,
    tagline: 'para quem espalha alegria por onde joga',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-futebol-arte-girassois-de-van-gogh-joga-bonita`,
  },
  {
    id: 'futebol-mulher-arte', nome: 'futebol de mulher é arte', img: imgFutebolMulherArte,
    tagline: 'para quem vive o futebol arte',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-futebol-de-mulher-e-arte-joga-bonita`,
  },
  {
    id: 'moca-perola', nome: 'moça com brinco de pérola', img: imgMocaPerola,
    tagline: 'para quem entra em campo com elegância',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-moca-com-brinco-de-perola-joga-bonita`,
  },
  {
    id: 'picasso', nome: 'futebol arte picasso', img: imgPicasso,
    tagline: 'para quem ama jogar futebol em abstrato',
    url: `${PRODUCT_BASE}feminina-de-futebol-estampa-futebol-arte-picasso-joga-bonita`,
  },
];

const PRICE = 109.9;
const COMPARE_AT = 139.9;

// Faixas de desconto progressivo (cupom FUTEBOLARTE).
const faixasDesconto = [
  { itens: 3, off: 30 },
  { itens: 5, off: 70 },
  { itens: 7, off: 100 },
];

const features = [
  { titulo: '100% algodão', desc: 'conforto de verdade para um dia inteiro.' },
  { titulo: 'modelagem confortável', desc: 'caimento pensado para vestir bem.' },
  { titulo: 'estampa premium', desc: 'alta definição e excelente durabilidade.' },
  { titulo: 'produção Reserva INK', desc: 'a mesma qualidade reconhecida da Reserva.' },
  { titulo: 'tecido respirável', desc: 'tecido leve para usar em qualquer ocasião.' },
];

const outrasEstampas = [
  { img: imgEstFutFem, alt: 'camiseta verde com "futebol feminino" em texto circular' },
  { img: imgEstBrasil, alt: 'torcedora com bola vestindo a camiseta "brasil"' },
  { img: imgEstCaramelo, alt: 'camiseta branca com o vira-lata caramelo assistindo futebol' },
  { img: imgEstMulher, alt: 'camiseta amarela "mulher também joga"' },
  { img: imgEstQueen, alt: 'camiseta branca "the queen" com a marta' },
];

// FAQ (sanfona). Texto em caixa natural — inclui marcas parceiras (Reserva INK).
const faq = [
  {
    pergunta: 'Por que comprar uma camiseta sobre futebol feminino da Joga Bonita?',
    resposta:
      'Vestir o futebol feminino é um ato de orgulho, estilo e posicionamento. Durante décadas, as mulheres foram desencorajadas a ocupar os espaços do futebol. Usar uma camiseta autoral da Joga Bonita é demarcar território na arquibancada, quebrar o preconceito e mostrar que o futebol também é nosso. Além disso, você foge das camisetas clichês e veste uma peça exclusiva, cheia de personalidade e com o caimento perfeito para o seu corpo.',
  },
  {
    pergunta: 'Como são feitas as camisetas da Joga Bonita e qual é a qualidade do tecido?',
    resposta:
      'As camisetas da Joga Bonita são produzidas sob demanda (print on demand) em parceria com a Reserva INK. Isso significa que cada peça é fabricada exclusivamente para você, utilizando o algodão premium da Reserva (fio penteado), famoso pelo toque macio, alta durabilidade e caimento perfeito. Nossas estampas são aplicadas digitalmente com tecnologia de ponta, que não racha e não desbota na lavagem.',
  },
  {
    pergunta: 'O que significa o selo Reserva INK no site?',
    resposta:
      'Significa que toda a nossa infraestrutura de tecnologia, produção, embalagem e logística é operada pela Reserva. Você compra uma estampa exclusiva e autoral da nossa marca Joga Bonita, mas recebe a garantia de qualidade, o tecido premium e a entrega garantida do grupo Reserva.',
  },
  {
    pergunta: 'Qual é o prazo de entrega da camiseta? Por que o prazo é diferente?',
    resposta:
      'A Joga Bonita trabalha no modelo de produção sustentável (sob demanda) e o seu pedido passa por duas etapas: produção + transporte. Assim que o seu pagamento é aprovado, a Reserva INK fabrica a sua camiseta em poucos dias úteis e a envia direto para a sua casa. O prazo total e o valor do frete variam de acordo com o seu CEP e são calculados automaticamente no carrinho.',
  },
  {
    pergunta: 'Como faço para rastrear o meu pedido?',
    resposta:
      'Assim que a Reserva INK iniciar a produção e o envio da sua camiseta for realizado, você receberá um código de rastreamento exclusivo por e-mail. Com ele, você poderá acompanhar cada etapa da entrega diretamente pelo site dos Correios ou da transportadora parceira.',
  },
  {
    pergunta: 'Como escolher o tamanho certo da camiseta (Clássica ou Babylook)?',
    resposta:
      'Para evitar erros, disponibilizamos uma Tabela de Medidas completa com as dimensões em centímetros na página de cada produto, no site da Joga Bonita. Recomendamos que você pegue uma camiseta que já goste do caimento, meça a largura e a altura, e compare com a nossa tabela. Oferecemos modelos que vão do PP ao 4G para atender a todos os corpos de torcedoras.',
  },
  {
    pergunta: 'Como funciona a primeira troca grátis se não servir?',
    resposta:
      'Se a sua camiseta não servir como você esperava, não se preocupe! A sua primeira troca é 100% grátis e pode ser realizada em até 30 dias após o recebimento. O processo é simples, rápido e feito diretamente pelo suporte da nossa loja em parceria com a Reserva INK, garantindo que você tenha a peça perfeita para torcer.',
  },
];
---

<Layout
  title="coleção futebol arte — joga bonita"
  description="cada estampa é uma obra-prima da arte mundial reinventada pelo futebol feminino. vista a sua favorita com 20% off na coleção joga bonita."
>
  <!-- ░░ utility bar ░░ -->
  <div class="bg-ink text-white">
    <p class="jb-container jb-eyebrow text-center py-2.5 text-white/85">
      coleção exclusiva · futebol feminino é arte · envio para todo o brasil
    </p>
  </div>

  <main id="topo">
    <!-- ░░ hero — the thesis ░░ -->
    <section class="relative overflow-hidden bg-forest text-white">
      <div class="jb-container pt-10 lg:pt-12">
        <a href="#topo" aria-label="joga bonita — início" class="inline-flex items-center">
          <img src={logoBranco.src} alt="joga bonita" class="h-28 lg:h-32 w-auto" />
        </a>
      </div>

      <div
        class="jb-container grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-8 items-center pt-6 pb-16 lg:pb-20"
      >
        <!-- copy -->
        <div class="relative z-10 max-w-xl">
          <p class="jb-eyebrow text-mint rise d1">coleção exclusiva</p>

          <h1 class="jb-display text-hero mt-4">
            <span class="block rise d1">futebol de mulher</span>
            <span class="block rise d2 mt-1">é arte</span>
          </h1>

          <p class="rise d4 mt-6 text-lg text-white/75 max-w-md leading-relaxed">
            vista uma coleção criada para quem transforma cada jogo em obra-prima.
          </p>

          <p class="rise d4 mt-4 text-base text-white/75 max-w-md leading-relaxed">
            <strong class="text-white font-bold">20% off</strong> em toda a coleção futebol arte
            + <strong class="text-white font-bold">desconto progressivo</strong> para quem compra mais
          </p>

          <div class="rise d4 mt-8 flex flex-wrap items-center gap-3">
            <Button href="#colecao" variant="primary" size="lg" class="cta-vendas">comprar minha camiseta</Button>
            <a
              href="#colecao"
              class="font-condensed font-bold uppercase tracking-[0.06em] text-sm text-white/80 hover:text-white underline underline-offset-4 decoration-mint decoration-2 px-2 py-2 transition"
              >quero apoiar o futebol feminino →</a
            >
          </div>
        </div>

        <!-- product -->
        <div class="relative flex flex-col items-center lg:items-end">
          <div class="mb-3 self-end">
            <Button href={COLLECTION_URL} variant="primary" size="sm" class="cta-vendas">comprar</Button>
          </div>
          <Image
            src={imgHero}
            alt="camiseta bege coleção futebol arte — estampa 'o grito da rainha', releitura da obra de munch com a jogadora marta"
            loading="eager"
            fetchpriority="high"
            widths={[260, 380, 440, 560]}
            sizes="(min-width: 1024px) 460px, 86vw"
            class="relative w-full max-w-[460px] rounded-xl shadow-lg rise d3"
          />
          <div class="rise d4 mt-5 inline-flex items-center gap-3 rounded-pill bg-white/10 border border-white/15 px-4 py-2.5 shadow-sm">
            <div class="flex gap-0.5 text-yellow" role="img" aria-label="nota 5 de 5 estrelas">
              {Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path d="m12 2 2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.8l1.2-6.6L2.5 9l6.6-.9L12 2Z" />
                </svg>
              ))}
            </div>
            <span class="w-px h-4 bg-white/20" aria-hidden="true"></span>
            <p class="font-condensed font-bold uppercase tracking-[0.03em] text-sm text-white/85">
              <span class="text-mint">+200</span> produtos vendidos
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ░░ trust strip — vídeo + checklist ░░ -->
    <section class="bg-white text-ink border-b border-gray-200">
      <div class="jb-container py-12 lg:py-16 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- TODO: trocar por <iframe> do YouTube quando o vídeo (não listado) estiver pronto -->
        <div class="relative aspect-video w-full rounded-lg bg-gray-100 border border-gray-200 flex items-center justify-center">
          <p class="jb-eyebrow text-ink-400">vídeo em breve</p>
        </div>

        <ul class="flex flex-col gap-4">
          {
            ['produtos 100% algodão', 'tecido respirável', 'qualidade reserva ink', 'produção sob demanda', 'entrega para todo brasil', 'compra segura'].map((t) => (
              <li class="flex items-center gap-3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 text-mint-700" aria-hidden="true">
                  <path d="m5 12 5 5L20 7" />
                </svg>
                <span class="text-lg text-ink-700">{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ░░ collection grid — escolha a sua estampa ░░ -->
    <section id="colecao" class="bg-white text-ink">
      <div class="jb-container py-12 lg:py-16">
        <div class="max-w-2xl">
          <p class="jb-eyebrow text-mint-700">coleção futebol arte</p>
          <h2 class="jb-display text-display mt-3">escolha a obra que mais combina com você</h2>
          <p class="mt-4 text-lg text-ink-600 max-w-xl leading-relaxed">
            cada estampa é uma releitura de grandes obras da arte mundial, reinterpretada sob
            o olhar criativo do futebol feminino. aproveite o desconto de 20% e garanta a sua!
          </p>
        </div>

        <div class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {
            estampas.map((e) => {
              const off = Math.round((1 - PRICE / COMPARE_AT) * 100);
              return (
                <a href={e.url} class="group block font-sans cta-vendas">
                  <div class="relative bg-gray-100 rounded-lg overflow-hidden aspect-[4/5]">
                    <div class="absolute top-3 left-3 z-10">
                      <Badge tone="sale">{off}% OFF</Badge>
                    </div>
                    <Image
                      src={e.img}
                      alt={`camiseta joga bonita — estampa ${e.nome}`}
                      widths={[220, 320, 440]}
                      sizes="(min-width: 1024px) 25vw, 45vw"
                      class="w-full h-full object-cover transition-transform duration-[320ms] ease-out group-hover:scale-[1.04]"
                    />
                  </div>
                  <h3 class="mt-3 text-[15px] font-bold lowercase text-ink leading-tight">{e.nome}</h3>
                  <p class="mt-0.5 text-sm text-ink-400 leading-snug">{e.tagline}</p>
                  <PriceTag price={PRICE} compareAt={COMPARE_AT} size="sm" class="mt-2" />
                </a>
              );
            })
          }
        </div>

        <!-- trust strip (real reassurances from the live store) -->
        <div class="mt-14 border-t border-gray-200 pt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto text-center">
          <div class="flex flex-col items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-mint-700" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 3v5h-5" />
            </svg>
            <p class="text-sm text-ink-600 leading-tight">
              <strong class="text-ink font-bold">primeira troca grátis</strong><br />até 30 dias pra trocar
            </p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-mint-700" aria-hidden="true">
              <path d="M12 2 4 5v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V5l-8-3Z" /><path d="m9 12 2 2 4-4" />
            </svg>
            <p class="text-sm text-ink-600 leading-tight">
              <strong class="text-ink font-bold">compra segura</strong><br />site oficial joga bonita
            </p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-mint-700" aria-hidden="true">
              <path d="M3 6h11v9H3z" /><path d="M14 9h4l3 3v3h-7z" /><circle cx="7.5" cy="18" r="1.6" /><circle cx="17" cy="18" r="1.6" />
            </svg>
            <p class="text-sm text-ink-600 leading-tight">
              <strong class="text-ink font-bold">envio pra todo o brasil</strong><br />pix com +3% off
            </p>
          </div>
        </div>

        <div class="mt-12 text-center">
          <Button href={COLLECTION_URL} variant="ink" size="lg" class="cta-vendas">
            conhecer toda a coleção
          </Button>
        </div>
      </div>
    </section>

    <!-- ░░ social proof — quem veste, aprova ░░ -->
    <section id="depoimentos" class="bg-mint-100 text-ink">
      <div class="jb-container py-12 lg:py-16">
        <div class="text-center max-w-2xl mx-auto">
          <p class="jb-eyebrow text-mint-700">clientes reais</p>
          <h2 class="jb-display text-display mt-3">quem veste, aprova</h2>
        </div>

        <div class="mt-12 max-w-md mx-auto">
          <figure class="flex flex-col overflow-hidden rounded-lg bg-white shadow-md">
            <Image
              src={imgGabriela}
              alt="Gabriela R. vestindo a camiseta joga bonita estampa abaporu boleira"
              widths={[320, 440, 600]}
              sizes="(min-width: 640px) 440px, 90vw"
              class="aspect-[4/5] w-full object-cover"
            />
            <figcaption class="flex flex-1 flex-col gap-3 p-6">
              <div>
                <p class="font-sans font-bold text-ink leading-tight">Gabriela R.</p>
              </div>
              <div class="flex gap-0.5 text-yellow" role="img" aria-label="nota 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path d="m12 2 2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.8l1.2-6.6L2.5 9l6.6-.9L12 2Z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-ink-600 leading-relaxed">
                "A que eu mais amo da Joga Bonita tem minha pintora preferida com o esporte que eu amo."
              </blockquote>
            </figcaption>
          </figure>
        </div>

        <div class="mt-12 text-center">
          <Button href={COLLECTION_URL} variant="ink" size="lg" class="cta-vendas">
            quero a minha também
          </Button>
        </div>
      </div>
    </section>

    <!-- ░░ features — camisetas lindas por fora e inesquecíveis por dentro ░░ -->
    <section class="bg-cream text-ink">
      <div class="jb-container py-12 lg:py-16">
        <h2 class="jb-display text-display text-center max-w-3xl mx-auto">
          camisetas lindas por fora e inesquecíveis por dentro
        </h2>

        <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-5 gap-8">
          {
            features.map((f) => (
              <div class="text-center">
                <div class="mx-auto w-12 h-12 rounded-full bg-mint-100 flex items-center justify-center">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-mint-700" aria-hidden="true">
                    <path d="m5 12 5 5L20 7" />
                  </svg>
                </div>
                <p class="mt-3 font-condensed font-bold uppercase tracking-[0.03em] text-ink text-base">
                  {f.titulo}
                </p>
                <p class="mt-1.5 text-sm text-ink-600 leading-snug">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ░░ promo — compre mais, economize mais ░░ -->
    <section class="bg-forest text-white">
      <Image
        src={imgPromoModelos}
        alt="modelos vestindo camisetas da coleção futebol arte"
        widths={[600, 900, 1200]}
        sizes="100vw"
        class="w-full max-h-[380px] object-cover"
      />

      <div class="jb-container py-12 lg:py-16">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <!-- copy -->
          <div>
            <img src={logoBranco.src} alt="joga bonita" class="h-8 w-auto" />
            <h2 class="jb-display text-display mt-6">
              compre mais,<br />
              <span class="jb-script text-mint not-italic text-[1.1em]">economize mais</span>
            </h2>

            <p class="mt-6 inline-flex items-center gap-2 rounded-pill border-2 border-white/25 px-4 py-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 text-mint" aria-hidden="true">
                <circle cx="7.5" cy="7.5" r="1" /><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2.5 12.5V4a1.5 1.5 0 0 1 1.5-1.5h8.5l8.09 8.09a2 2 0 0 1 0 2.82Z" />
              </svg>
              <span class="text-white/70 text-sm">use o cupom:</span>
              <span class="font-condensed font-bold uppercase tracking-[0.04em] text-mint">futebolarte</span>
            </p>

            <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
              {
                ['100% algodão', 'tecido respirável', 'qualidade reserva'].map((t) => (
                  <div class="flex flex-col items-center gap-2 w-20 text-center">
                    <div class="w-11 h-11 rounded-full border border-white/25 flex items-center justify-center">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-mint" aria-hidden="true">
                        <path d="m5 12 5 5L20 7" />
                      </svg>
                    </div>
                    <p class="jb-eyebrow text-white/70 text-[10px] leading-tight">{t}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- discount tickets -->
          <div class="flex flex-col gap-7">
            {
              faixasDesconto.map((f) => (
                <div class="relative">
                  <div class="flex items-center justify-between px-1 relative z-10 mb-[-14px]">
                    <span class="rounded-pill bg-white text-ink text-xs font-condensed font-bold uppercase px-3 py-1 shadow-sm">
                      {f.itens} itens
                    </span>
                    <span class="flex gap-0.5 text-white">
                      {Array.from({ length: f.itens }).map(() => (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true">
                          <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z" />
                        </svg>
                      ))}
                    </span>
                  </div>
                  <div class="rounded-lg bg-white/10 pt-6 pb-3 px-5 flex items-baseline justify-end gap-1.5">
                    <span class="jb-display text-mint text-[clamp(1.8rem,5vw,2.5rem)] leading-none">
                      R$ {f.off},00
                    </span>
                    <span class="jb-eyebrow text-white/70">off</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-10 text-center">
          <Button href={COLLECTION_URL} variant="primary" size="lg" class="cta-vendas">comprar agora</Button>
        </div>
      </div>
    </section>

    <!-- ░░ manifesto — criada por mulheres ░░ -->
    <section id="manifesto" class="bg-white text-ink">
      <div class="jb-container py-12 lg:py-16 grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <Image
            src={imgFundadoras}
            alt="fundadoras da joga bonita"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            class="w-full rounded-lg shadow-md object-cover"
          />
        </div>

        <div class="order-1 lg:order-2">
          <p class="jb-eyebrow text-magenta-700">joga bonita</p>
          <h2 class="jb-display text-display mt-3">criada por mulheres</h2>
          <p class="mt-2 text-lg text-ink-600 max-w-lg">
            para mulheres que fazem do futebol parte da própria história.
          </p>
          <p class="mt-6 text-lg text-ink-600 leading-relaxed max-w-lg">
            a joga bonita nasceu para representar quem, por muito tempo, precisou provar que
            também pertencia ao futebol.
          </p>
          <p class="mt-4 text-lg text-ink-600 leading-relaxed max-w-lg">
            hoje, fazemos isso através do design. da criatividade. e de camisetas que
            transformam paixão em representatividade.
          </p>
        </div>
      </div>
    </section>

    <!-- ░░ faq — sanfona ░░ -->
    <section id="faq" class="bg-cream text-ink">
      <div class="jb-container py-12 lg:py-16">
        <div class="text-center max-w-2xl mx-auto">
          <p class="jb-eyebrow text-magenta-700">joga bonita &amp; reserva ink</p>
          <h2 class="jb-display text-display mt-3">perguntas frequentes (faq)</h2>
        </div>

        <div class="mt-10 max-w-3xl mx-auto border-t border-sand">
          {
            faq.map((item) => (
              <details class="border-b border-sand">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-5 [&::-webkit-details-marker]:hidden">
                  <span class="faq-q font-sans font-bold text-ink text-lg leading-snug transition-colors">
                    {item.pergunta}
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="faq-chevron h-5 w-5 shrink-0 text-mint-700 transition-transform duration-200 motion-reduce:transition-none"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="pb-5 pr-8 text-ink-600 leading-relaxed">{item.resposta}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ░░ apoie o futebol feminino + fechamento ░░ -->
    <section class="bg-white text-ink">
      <div class="jb-container py-12 lg:py-16 text-center">
        <p class="jb-eyebrow text-mint-700">apoie o futebol feminino</p>
        <h2 class="jb-display text-display mt-3 max-w-2xl mx-auto">o futebol delas não para por aqui</h2>
        <p class="mt-5 text-lg text-ink-600 leading-relaxed max-w-2xl mx-auto">
          nossa paixão pelo futebol feminino vai muito além de uma única coleção. todas as
          nossas estampas são criadas por mulheres, com muito carinho, para mulheres que
          vivem este esporte de corpo e alma.
        </p>

        <ul class="mt-10 grid grid-cols-2 sm:grid-cols-5 gap-4 max-w-3xl mx-auto">
          {
            outrasEstampas.map((e) => (
              <li class="overflow-hidden rounded-lg bg-gray-100">
                <Image
                  src={e.img}
                  alt={e.alt}
                  widths={[160, 220, 320]}
                  sizes="(min-width: 1024px) 200px, 33vw"
                  class="aspect-[4/5] w-full object-cover"
                />
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <Button href={COLLECTION_URL} variant="primary" size="lg" class="cta-vendas">quero garantir 20% off</Button>
        </div>

        <hr class="mt-12 border-gray-200 max-w-3xl mx-auto" />

        <div class="mt-10 flex flex-col items-center gap-3">
          <img src={logoPreto.src} alt="joga bonita" class="h-14 w-auto" />
          <p class="font-sans font-bold text-xl text-ink">vista o futebol como ele merece ser visto!</p>
          <p class="text-ink-600">vamos juntas fortalecer o futebol feminino por aí.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- ░░ footer ░░ -->
  <footer class="bg-ink text-white/70">
    <div class="jb-container py-12 flex flex-col sm:flex-row gap-6 items-center justify-between">
      <img src={logoBranco.src} alt="joga bonita" class="h-11 w-auto" />
      <p class="jb-eyebrow text-center sm:text-right text-white/55">
        joga bonita — moda do futebol feminino · rio de janeiro<br />
        © 2026 joga bonita · todos os direitos reservados
      </p>
    </div>
  </footer>
</Layout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  /* ── hero entrance — transform-only so the LCP element paints immediately
     (animating opacity from 0 would delay Largest Contentful Paint) ── */
  .rise {
    animation: rise 0.6s var(--ease-out) both;
  }
  .d1 { animation-delay: 0.05s; }
  .d2 { animation-delay: 0.15s; }
  .d3 { animation-delay: 0.25s; }
  .d4 { animation-delay: 0.35s; }
  @keyframes rise {
    from {
      transform: translateY(16px);
    }
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
      transform: none;
    }
  }

  /* ── FAQ accordion: chevron flips open, question tints on hover ── */
  details[open] > summary .faq-chevron {
    transform: rotate(180deg);
  }
  summary:hover .faq-q {
    color: var(--jb-mint-700);
  }
</style>
