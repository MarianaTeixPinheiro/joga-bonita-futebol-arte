<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  /* painéis de corredor escondidos */
  [data-panel][hidden] {
    display: none !important;
  }

  /* ── ticker da barra de urgência ── */
  .ticker {
    animation: ticker 26s linear infinite;
    width: max-content;
  }
  @keyframes ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .pulse-dot {
    animation: pulseDot 1.6s var(--ease-out) infinite;
  }
  @keyframes pulseDot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  /* ── entrada do hero — só transform, pra não atrasar o LCP ── */
  .rise {
    animation: rise 0.6s var(--ease-out) both;
  }
  .d1 { animation-delay: 0.05s; }
  .d2 { animation-delay: 0.15s; }
  .d3 { animation-delay: 0.25s; }
  .d4 { animation-delay: 0.35s; }
  @keyframes rise {
    from {
      transform: translateY(16px);
    }
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .ticker,
    .pulse-dot {
      animation: none;
      transform: none;
    }
  }

  /* ── FAQ: chevron gira, pergunta tinge no hover ── */
  details[open] > summary .faq-chevron {
    transform: rotate(180deg);
  }
  summary:hover .faq-q {
    color: var(--jb-mint-700);
  }
</style>

<script>
  // Filtro de corredores: o chip clicado troca o painel visível.
  const section = document.getElementById('outlet');
  if (section) {
    const chips = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-select]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));
    const show = (id: string | null) => {
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
      chips.forEach((c) => {
        c.setAttribute('aria-pressed', String(c.dataset.select === id));
      });
    };
    chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.select ?? null)));
  }
</script>
