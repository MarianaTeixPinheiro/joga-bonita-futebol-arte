---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import { brl } from '../lib/format';

import logoPreto from '../assets/img/joga-bonita-ver-preto.png';
import logoBranco from '../assets/img/joga-bonita-ver-branco.png';

// Selo de qualidade Reserva.INK (recortado da foto oficial) + fundadoras.
import selo from '../assets/img/selo-reserva-ink.png';
import imgFundadoras from '../assets/img/fundadoras.png';

// Depoimentos reais (clientes da loja).
import imgCarolina from '../assets/img/dobra3-depoimento-carolina.webp';
import imgAna from '../assets/img/dobra3-depoimento-ana.webp';
import imgGabrielaR from '../assets/img/depoimento-gabriela.jpeg';

// ── Estampas · visibilidade futebol feminino ──
import imgMarta10 from '../assets/img/loja/marta-10.webp';
import imgGodSave from '../assets/img/loja/god-save-the-queen.webp';
import imgElasJogam from '../assets/img/loja/elas-jogam.webp';
import imgArtilheira from '../assets/img/loja/artilheira.webp';
import imgGoleira from '../assets/img/loja/goleira.webp';
import imgPlayLikeWoman from '../assets/img/loja/play-like-a-woman.webp';
import img9xCampeas from '../assets/img/loja/9x-campeas-america.webp';
import imgFutFemCentro from '../assets/img/loja/futebol-feminino-centro.webp';

// ── Estampas · futebol arte (fotos de modelo, da coleção futebol arte) ──
import imgDuasFridas from '../assets/img/loja/duas-fridas.webp';
import imgDuasFridasPreta from '../assets/img/loja/duas-fridas-preta.webp'; // versão preta, usada no hero
import imgNoiteEstrelada from '../assets/img/estampa-noite-estrelada.png';
import imgAbaporu from '../assets/img/estampa-abaporu-boleira.png';
import imgGritoRainha from '../assets/img/estampa-o-grito-da-rainha.png';
import imgGirassois from '../assets/img/estampa-girassois-van-gogh.png';
import imgFutMulherArte from '../assets/img/estampa-futebol-de-mulher-e-arte.png';
// ⚠ Estes três arquivos estão com o nome trocado no repositório (o mesmo engano
// existe em futebol-arte.astro). O alias abaixo segue o CONTEÚDO da foto, não o
// nome do arquivo — não "corrija" trocando pelo arquivo homônimo.
import imgMocaPerola from '../assets/img/estampa-ultima-resenha.png'; // = moça com brinco de pérola
import imgPicasso from '../assets/img/estampa-moca-com-brinco-de-perola.png'; // = futebol arte picasso
import imgUltimaResenha from '../assets/img/estampa-futebol-arte-picasso.png'; // = a última resenha

// ── Estampas · meme ──
import imgTocaBola from '../assets/img/loja/toca-a-bola-carai.webp';
import imgMaoAlface from '../assets/img/loja/mao-de-alface.webp';
import imgFizOQuePude from '../assets/img/loja/fiz-o-que-pude.webp';
import imgJogadoraCansada from '../assets/img/loja/jogadora-cansada.webp';
import imgCulpaDelas from '../assets/img/loja/culpa-e-delas.webp';
import imgMeuTime from '../assets/img/loja/meu-time-me-obriga.webp';
import imgGolVW from '../assets/img/loja/gol-volkswagen.webp';
import imgTocaDesgrama from '../assets/img/loja/toca-a-desgrama.webp';

/* ----------------------------------------------------------------------------
 * Landing — "outlet futebol feminino"
 *
 * Três objetivos, nessa ordem de peso:
 *   1. MOVIMENTO — o inimigo comum (a invisibilidade histórica delas) aparece
 *      pelos fatos, nunca pelo rótulo. É o que dá causa à compra.
 *   2. VENDA — a arara do outlet, curada, com preço fechado e cupom.
 *   3. CREDIBILIDADE — marca pequena e autoral apoiada na infra da Reserva INK:
 *      selo de qualidade, depoimentos reais, fundadoras com rosto e garantia.
 *
 * Preço da loja: R$ 139,90 → R$ 109,90 (21% OFF). Cupom PRIMEIRAJOGADA dá mais
 * 10% na 1ª compra (cumulativo) e o pix dá +3%.
 * -------------------------------------------------------------------------- */
const STORE_URL = 'https://www.jogabonita.com.br/jogabonita';
const PRODUCT_BASE = `${STORE_URL}/product/`;

const PRICE = 109.9;
const COMPARE_AT = 139.9;

const CUPOM = 'PRIMEIRAJOGADA';
const priceCupom = PRICE * 0.9; // cupom de 10% na 1ª compra
const pricePix = priceCupom * 0.97; // +3% no pix
const offLoja = Math.round((1 - PRICE / COMPARE_AT) * 100); // 21%

// A estrela do hero + a segunda estampa da vez.
const heroPrincipal = {
  nome: 'duas fridas',
  selo: 'a mais desejada',
  img: imgDuasFridasPreta,
  alt: 'camiseta preta com a releitura de "as duas fridas" de frida kahlo em uniforme de futebol',
  url: `${PRODUCT_BASE}feminina-de-futebol-arte-estampa-duas-fridas-joga-bonita`,
};
const heroSecundaria = {
  nome: 'god save the queen marta',
  img: imgGodSave,
  alt: 'camiseta branca com o rosto da marta e a frase "god save the queen"',
  url: `${PRODUCT_BASE}god-save-the-queen-marta`,
};

/* Curadoria por corredor — só o que tem demanda comprovada, nada de catálogo cru. */
const categorias = [
  {
    id: 'visibilidade',
    label: 'visibilidade futebol feminino',
    curta: 'visibilidade',
    titulo: 'quem joga merece ser vista',
    desc: 'estampas que dizem o nome delas em voz alta. pra vestir na arquibancada, na pelada e no meio da rua.',
    produtos: [
      { nome: 'marta é 10', tagline: 'a maior de todos os tempos, no peito', img: imgMarta10, destaque: 'mais vendida', alt: 'camiseta com a estampa "marta é 10"', slug: 'feminina-de-futebol-estampa-marta-10-joga-bonita' },
      { nome: 'god save the queen marta', tagline: 'a rainha em estêncil de rua', img: imgGodSave, destaque: null, alt: 'camiseta branca "god save the queen" com a marta', slug: 'god-save-the-queen-marta' },
      { nome: 'elas jogam', tagline: 'duas palavras que ainda precisam ser ditas', img: imgElasJogam, destaque: null, alt: 'camiseta com a estampa "elas jogam"', slug: 'elas-jogam' },
      { nome: 'artilheira', tagline: 'pra quem sempre aparece na hora do gol', img: imgArtilheira, destaque: null, alt: 'camiseta com a estampa "artilheira"', slug: 'feminina-de-futebol-estampa-artilheira-joga-bonita' },
      { nome: 'goleira', tagline: 'quem defende o gol defende o espaço', img: imgGoleira, destaque: null, alt: 'camiseta com a estampa "goleira"', slug: 'feminina-de-futebol-estampa-goleira-joga-bonita' },
      { nome: 'play like a woman', tagline: 'jogar como uma mulher é elogio', img: imgPlayLikeWoman, destaque: null, alt: 'camiseta com a estampa "play like a woman"', slug: 'play-like-a-woman-477b26bd-168d-4a38-beca-7655762aa677' },
      { nome: '9x campeãs da américa', tagline: 'nove títulos que quase ninguém contou', img: img9xCampeas, destaque: null, alt: 'camiseta com a estampa "9x campeãs da américa"', slug: '9x-campeas-da-america' },
      { nome: 'futebol feminino no centro', tagline: 'tirando elas da margem do campo', img: imgFutFemCentro, destaque: null, alt: 'camiseta com a estampa "futebol feminino no centro"', slug: 'futebol-feminino-no-centro' },
    ],
  },
  {
    id: 'futebol-arte',
    label: 'futebol arte',
    curta: 'futebol arte',
    titulo: 'obras-primas que entraram em campo',
    desc: 'grandes obras da arte mundial reinterpretadas com bola no pé. arte no museu e arte na pelada são a mesma coisa.',
    produtos: [
      { nome: 'duas fridas', tagline: 'frida em campo, de mãos dadas', img: imgDuasFridas, destaque: 'a mais desejada', alt: 'camiseta verde com a releitura de "as duas fridas"', slug: 'feminina-de-futebol-arte-estampa-duas-fridas-joga-bonita' },
      { nome: 'o grito da rainha', tagline: 'munch entendeu o que é ver um pênalti', img: imgGritoRainha, destaque: null, alt: 'modelo vestindo a camiseta com a releitura de "o grito" de munch', slug: 'feminina-de-futebol-arte-estampa-o-grito-da-rainha-joga-bonita' },
      { nome: 'abaporu boleira', tagline: 'tarsila de chuteira', img: imgAbaporu, destaque: null, alt: 'modelo vestindo a camiseta com a releitura do abaporu de tarsila do amaral', slug: 'feminina-de-futebol-estampa-abaporu-boleira-joga-bonita' },
      { nome: 'a noite perfeita', tagline: 'van gogh pra quem joga toda santa noite', img: imgNoiteEstrelada, destaque: null, alt: 'modelo vestindo a camiseta com a releitura da noite estrelada de van gogh', slug: 'feminina-de-futebol-estampa-noite-estrelada-joga-bonita' },
      { nome: 'girassóis de van gogh', tagline: 'pra quem espalha alegria por onde joga', img: imgGirassois, destaque: null, alt: 'modelo vestindo a camiseta com a releitura dos girassóis de van gogh', slug: 'feminina-de-futebol-estampa-futebol-arte-girassois-de-van-gogh-joga-bonita' },
      { nome: 'moça com brinco de pérola', tagline: 'vermeer com a elegância de quem entra em campo', img: imgMocaPerola, destaque: null, alt: 'modelo vestindo a camiseta com a releitura da moça com brinco de pérola', slug: 'feminina-de-futebol-estampa-moca-com-brinco-de-perola-joga-bonita' },
      { nome: 'futebol de mulher é arte', tagline: 'a frase que resume a coleção inteira', img: imgFutMulherArte, destaque: null, alt: 'modelo vestindo a camiseta "futebol de mulher é arte"', slug: 'feminina-de-futebol-estampa-futebol-de-mulher-e-arte-joga-bonita' },
      { nome: 'a última resenha', tagline: 'pra quem está sempre pronta', img: imgUltimaResenha, destaque: null, alt: 'modelo vestindo a camiseta com a releitura da última ceia em versão resenha', slug: 'feminina-de-futebol-estampa-ultima-resenha-joga-bonita' },
      { nome: 'futebol arte picasso', tagline: 'pra quem ama jogar futebol em abstrato', img: imgPicasso, destaque: null, alt: 'modelo vestindo a camiseta com a releitura cubista de picasso', slug: 'feminina-de-futebol-estampa-futebol-arte-picasso-joga-bonita' },
    ],
  },
  {
    id: 'meme',
    label: 'meme',
    curta: 'meme',
    titulo: 'a resenha que só quem joga entende',
    desc: 'as frases que a gente fala no grupo depois do jogo. agora dá pra vestir e não precisar explicar.',
    produtos: [
      { nome: 'toca a bola, carai', tagline: 'o grito universal de toda pelada', img: imgTocaBola, destaque: 'a mais pedida', alt: 'camiseta com a estampa "toca a bola, carai"', slug: 'toca-a-bola-carai' },
      { nome: 'mão de alface', tagline: 'a gente já perdoou. já colou na camiseta', img: imgMaoAlface, destaque: null, alt: 'camiseta com a estampa "mão de alface"', slug: 'feminina-de-futebol-estampa-mao-de-alface-joga-bonita' },
      { nome: 'fiz o que pude', tagline: 'o resumo honesto do seu domingo', img: imgFizOQuePude, destaque: null, alt: 'camiseta com a estampa "fiz o que pude"', slug: 'feminina-de-futebol-estampa-fiz-o-que-pude-joga-bonita' },
      { nome: 'jogadora cansada', tagline: 'joguei 90 minutos e o corpo cobrou', img: imgJogadoraCansada, destaque: null, alt: 'camiseta com a estampa "jogadora cansada"', slug: 'jogadora-cansada' },
      { nome: 'se eu jogo mal a culpa é delas', tagline: 'resenha em forma de camiseta', img: imgCulpaDelas, destaque: null, alt: 'camiseta com a estampa "se eu jogo mal a culpa é delas"', slug: 'se-eu-jogo-mal-a-culpa-e-delas' },
      { nome: 'meu time me obriga a beber', tagline: 'torcer dói. beber ajuda', img: imgMeuTime, destaque: null, alt: 'camiseta com a estampa "meu time me obriga a beber"', slug: 'meu-time-me-obriga-a-beber-eb8d9e0d-da60-4d12-9707-0bae9f0bb53e' },
      { nome: 'jogo pela resenha', tagline: 'o pós-jogo é o verdadeiro jogo', img: imgGolVW, destaque: null, alt: 'camiseta com a estampa "jogo pela resenha, gol volkswagen"', slug: 'jogo-pela-resenha-gol-volkswagen' },
      { nome: 'toca a desgrama da bola', tagline: 'quando o "toca a bola" já não basta', img: imgTocaDesgrama, destaque: null, alt: 'camiseta com a estampa "toca a desgrama da bola"', slug: 'feminina-de-futebol-estampa-toca-a-desgrama-da-bola-joga-bonita' },
    ],
  },
];

/* A arara inteira + cada corredor separado. */
const corredores = [
  {
    id: 'tudo',
    label: 'a arara inteira',
    titulo: 'a arara completa',
    desc: 'as estampas que mais saem da loja, penduradas num lugar só. o que estiver aqui está com o desconto, sem exceção.',
    produtos: categorias.flatMap((c) => c.produtos.map((p) => ({ ...p, corredor: c.curta }))),
  },
  ...categorias.map((c) => ({
    id: c.id,
    label: c.label,
    titulo: c.titulo,
    desc: c.desc,
    produtos: c.produtos.map((p) => ({ ...p, corredor: c.curta })),
  })),
];

/* Atributos do produto — o que a peça é, sem adjetivo de vendedor. */
const atributos = [
  {
    titulo: '100% algodão',
    desc: 'fio penteado, o mesmo padrão que a reserva usa nas peças dela. não encolhe na primeira lavagem.',
  },
  {
    titulo: 'tecido respirável',
    desc: 'leve o bastante pra passar o dia inteiro vestindo, do jogo à resenha, sem grudar no corpo.',
  },
  {
    titulo: 'qualidade reserva',
    desc: 'produção, embalagem e logística operadas pelo grupo reserva. a estampa é digital: não racha, não desbota.',
  },
  {
    titulo: '1ª troca sem custo',
    desc: 'errou o tamanho? a primeira troca é grátis em até 30 dias. o risco é nosso, não seu.',
  },
];

// Depoimentos reais (foto + nota + citação verbatim de clientes da loja).
const depoimentos = [
  {
    nome: 'Gabriella O.', local: 'Rio de Janeiro/RJ', img: imgCarolina,
    texto:
      '“Comprei o modelo clássico (unissex) e adorei o caimento mais solto. Entrega super rápida e o atendimento foi excelente. É muito bom andar na rua sabendo que a nossa estampa carrega uma mensagem tão forte sobre o futebol feminino.”',
  },
  {
    nome: 'Gabriela R.', local: 'cliente joga bonita', img: imgGabrielaR,
    texto:
      '“A que eu mais amo da Joga Bonita tem minha pintora preferida com o esporte que eu amo.”',
  },
  {
    nome: 'Ana P.', local: 'Manaus/AM', img: imgAna,
    texto:
      '“Amei muito essa estampa, ela super me representa! E amei mais ainda a qualidade da camiseta. Realmente é 100% algodão. Bom demais saber que agora temos uma marca que reconhece e valoriza o futebol feminino.”',
  },
];

// FAQ (sanfona) — dúvidas de compra + as objeções específicas do outlet.
const faq = [
  {
    pergunta: 'Como funciona o cupom PRIMEIRAJOGADA? Ele soma com o desconto do outlet?',
    resposta:
      'Sim, ele é cumulativo. As camisetas do outlet já estão de R$ 139,90 por R$ 109,90 (21% OFF) e o cupom PRIMEIRAJOGADA aplica mais 10% na sua primeira compra, levando a peça para R$ 98,91. Se você ainda pagar no Pix, ganha mais 3% e o valor final fica em R$ 95,94. Basta digitar o código no carrinho, antes de finalizar o pedido.',
  },
  {
    pergunta: 'Nunca ouvi falar da Joga Bonita. Posso confiar?',
    resposta:
      'A Joga Bonita é uma marca autoral pequena, criada por duas mulheres no Rio de Janeiro. As estampas e a mensagem são nossas. Mas a parte pesada (produção, tecido, embalagem, envio e trocas) é operada pela Reserva INK, do grupo Reserva. Na prática: você compra de uma marca independente e recebe com a estrutura de uma grande. Já são mais de 200 produtos vendidos e as avaliações ficam na página de cada camiseta.',
  },
  {
    pergunta: 'Por que comprar uma camiseta sobre futebol feminino da Joga Bonita?',
    resposta:
      'Vestir o futebol feminino é um ato de orgulho, estilo e posicionamento. Durante décadas, as mulheres foram desencorajadas a ocupar os espaços do futebol. Usar uma camiseta autoral da Joga Bonita é demarcar território na arquibancada, quebrar o preconceito e mostrar que o futebol também é nosso. Além disso, você foge das camisetas clichês e veste uma peça exclusiva, cheia de personalidade e com o caimento perfeito para o seu corpo.',
  },
  {
    pergunta: 'Como são feitas as camisetas e qual é a qualidade do tecido?',
    resposta:
      'As camisetas da Joga Bonita são produzidas sob demanda (print on demand) em parceria com a Reserva INK. Isso significa que cada peça é fabricada exclusivamente para você, utilizando o algodão premium da Reserva (fio penteado), famoso pelo toque macio, alta durabilidade e caimento perfeito. Nossas estampas são aplicadas digitalmente com tecnologia de ponta, que não racha e não desbota na lavagem.',
  },
  {
    pergunta: 'O que significa o selo Reserva INK no site?',
    resposta:
      'Significa que toda a nossa infraestrutura de tecnologia, produção, embalagem e logística é operada pela Reserva. Você compra uma estampa exclusiva e autoral da nossa marca Joga Bonita, mas recebe a garantia de qualidade, o tecido premium e a entrega garantida do grupo Reserva.',
  },
  {
    pergunta: 'Qual é o prazo de entrega? Por que o prazo é diferente?',
    resposta:
      'A Joga Bonita trabalha no modelo de produção sustentável (sob demanda) e o seu pedido passa por duas etapas: produção + transporte. Assim que o seu pagamento é aprovado, a Reserva INK fabrica a sua camiseta em poucos dias úteis e a envia direto para a sua casa. O prazo total e o valor do frete variam de acordo com o seu CEP e são calculados automaticamente no carrinho.',
  },
  {
    pergunta: 'Como escolher o tamanho certo da camiseta (Clássica ou Babylook)?',
    resposta:
      'Para evitar erros, disponibilizamos uma Tabela de Medidas completa com as dimensões em centímetros na página de cada produto. Recomendamos que você pegue uma camiseta que já goste do caimento, meça a largura e a altura, e compare com a nossa tabela. Oferecemos modelos que vão do PP ao 4G para atender a todos os corpos de torcedoras.',
  },
  {
    pergunta: 'E se não servir? Como funciona a primeira troca grátis?',
    resposta:
      'Se a sua camiseta não servir como você esperava, não se preocupe! A sua primeira troca é 100% grátis e pode ser realizada em até 30 dias após o recebimento, inclusive para as peças compradas no outlet. O processo é simples, rápido e feito diretamente pelo suporte da nossa loja em parceria com a Reserva INK.',
  },
];
---

<Layout
  title="outlet futebol feminino · joga bonita"
  description="o outlet da joga bonita: camisetas autorais de futebol feminino, futebol arte e meme a partir de R$ 95,94 com o cupom PRIMEIRAJOGADA. 100% algodão, produção Reserva INK, primeira troca grátis."
>
  <!-- ░░ barra de urgência ░░ -->
  <div class="bg-sale text-white overflow-hidden">
    <div class="ticker flex whitespace-nowrap py-2.5">
      {
        Array.from({ length: 2 }).map(() => (
          <p class="jb-eyebrow flex shrink-0 items-center gap-8 pr-8 text-white/95" aria-hidden="true">
            <span>outlet futebol feminino · últimos dias</span>
            <span>·</span>
            <span>cupom {CUPOM} · +10% na 1ª compra</span>
            <span>·</span>
            <span>todas com {offLoja}% off</span>
            <span>·</span>
            <span>envio pra todo o brasil</span>
            <span>·</span>
          </p>
        ))
      }
    </div>
    <p class="sr-only">
      Outlet futebol feminino, últimos dias. Todas as estampas com {offLoja}% de desconto. Use o
      cupom {CUPOM} e ganhe mais 10% na primeira compra.
    </p>
  </div>

  <!-- ░░ header ░░ -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200">
    <div class="jb-container flex items-center justify-between h-12 lg:h-[var(--header-h)]">
      <a href="#topo" aria-label="joga bonita, voltar ao topo" class="flex items-center">
        <img src={logoPreto.src} alt="joga bonita" class="h-5 lg:h-7 w-auto" />
      </a>
      <Button href="#outlet" variant="ink" size="sm" class="cta-vendas">ver o outlet</Button>
    </div>
  </header>

  <main id="topo">
    <!-- ░░ 1. hero ░░ -->
    <section class="relative overflow-hidden bg-ink text-white">
      <div class="jb-container py-12 lg:py-20">
        <p class="jb-eyebrow rise d1 inline-flex items-center gap-2 rounded-pill bg-sale px-3 py-1.5 text-white">
          <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true"></span>
          outlet futebol feminino
        </p>

        <!-- De sm pra cima: texto de um lado, camiseta do outro (e o bloco de baixo,
             parágrafo + CTA, atravessa as duas colunas). No mobile tudo empilha, pra
             a camiseta poder ocupar largura de verdade em vez de uma coluna estreita. -->
        <div
          class="mt-6 grid grid-cols-1 sm:grid-cols-[1.12fr_0.88fr] lg:grid-cols-[1fr_0.92fr] gap-x-4 gap-y-7 sm:gap-y-8 sm:gap-x-8 lg:gap-x-16 items-start"
        >
          <!-- manchete -->
          <div class="sm:col-start-1 sm:row-start-1 self-center min-w-0">
            <h1 class="jb-display text-[clamp(1.95rem,8.4vw,4.6rem)]">
              <span class="block rise d1">se não dão espaço,</span>
              <span class="block rise d2 mt-1">a gente <span class="text-mint">ocupa</span>.</span>
            </h1>

            <p class="rise d3 jb-script text-yellow text-[clamp(1.2rem,5.2vw,2.1rem)] leading-tight mt-3">
              no peito, na rua, na arquibancada.
            </p>
          </div>

          <!-- a estrela do outlet -->
          <div class="sm:col-start-2 sm:row-start-1 lg:row-span-2 self-center rise d3 min-w-0 w-full max-w-[19rem] mx-auto sm:max-w-none sm:mx-0">
            <a href={heroPrincipal.url} class="group block cta-vendas">
              <div class="relative">
                <div class="relative overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-white/10">
